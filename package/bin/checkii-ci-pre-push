#!/usr/bin/env python3
"""pre-commit ``pre-push`` entry: assess the pushed range with ``checkii-ci``.

pre-commit runs this script from the hook repository's checkout, so the
package next to it is imported directly and nothing is installed. The pushed
range comes from the variables pre-commit sets for the pre-push stage
(``PRE_COMMIT_FROM_REF``, ``PRE_COMMIT_TO_REF``, ``PRE_COMMIT_LOCAL_BRANCH``,
``PRE_COMMIT_REMOTE_BRANCH``); any flag given in the hook's ``args`` wins.
The token is read from CHECKII_API_TOKEN. Exit codes are those of
``checkii-ci assess``; a push with no base to compare against is refused (2),
never waved through.
"""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

PACKAGE = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(PACKAGE))

from checkii_ci.cli import main  # noqa: E402

UNBORN = "0" * 40


def _present(argv: list[str], flag: str) -> bool:
    return any(item == flag or item.startswith(flag + "=") for item in argv)


def _git(*arguments: str) -> str | None:
    try:
        return subprocess.run(
            ["git", *arguments], capture_output=True, text=True, check=True
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return None


def _defaults(argv: list[str]) -> list[str] | None:
    head = os.getenv("PRE_COMMIT_TO_REF") or _git("rev-parse", "HEAD")
    base = os.getenv("PRE_COMMIT_FROM_REF")
    if not base or base == UNBORN:
        # A new branch: compare against the remote's default branch tip.
        remote = os.getenv("PRE_COMMIT_REMOTE_NAME") or "origin"
        base = _git("rev-parse", f"{remote}/HEAD")
    if not head or not base:
        return None
    extra: list[str] = []
    if not _present(argv, "--head-commit"):
        extra += ["--head-commit", head]
    if not _present(argv, "--base-commit"):
        extra += ["--base-commit", base]
    if not _present(argv, "--head-ref"):
        extra += ["--head-ref", os.getenv("PRE_COMMIT_LOCAL_BRANCH") or "HEAD"]
    if not _present(argv, "--base-ref"):
        extra += ["--base-ref", os.getenv("PRE_COMMIT_REMOTE_BRANCH") or "HEAD"]
    if not _present(argv, "--idempotency-key") and not any(
        os.getenv(name)
        for name in ("CHECKII_CI_IDEMPOTENCY_KEY", "AEGIS_CI_IDEMPOTENCY_KEY")
    ):
        extra += ["--idempotency-key", f"pre-push:{base[:12]}:{head[:12]}"]
    return extra


def run(argv: list[str]) -> int:
    extra = _defaults(argv)
    if extra is None:
        print(
            "checkii-ci-pre-push: cannot determine the pushed range; "
            "pass --head-commit and --base-commit in the hook's args",
            file=sys.stderr,
        )
        return 2
    return main(["assess", *argv, *extra])


if __name__ == "__main__":
    raise SystemExit(run(sys.argv[1:]))
